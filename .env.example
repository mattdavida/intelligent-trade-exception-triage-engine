# Copy from deploy output, or run: .\infra\deploy.ps1
# App fails fast if Azure OpenAI vars are missing — there is no stub path.

# ─── Azure OpenAI (required) ──────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=                  # e.g. https://oai-itee-dev-xxxxxx.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4

# ─── AI engine ↔ Java orchestrator ────────────────────────────────────────────
AI_ENGINE_API_KEY=                      # shared secret; deploy.ps1 generates one
AI_ENGINE_BASE_URL=http://localhost:8000

# ─── Local stack ──────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=8081
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=itee
POSTGRES_USER=itee
POSTGRES_PASSWORD=itee
